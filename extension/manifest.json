{
  "manifest_version": 3,
  "name": "CareerOps LinkedIn Importer",
  "version": "2.7",
  "description": "Importe vagas do LinkedIn para sua plataforma de Career Ops",
  "permissions": [
    "activeTab",
    "storage",
    "cookies",
    "scripting",
    "tabs",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon128.png",
      "48": "icons/icon128.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/view/*",
        "https://www.linkedin.com/jobs/search/*",
        "https://www.linkedin.com/jobs/collections/*",
        "https://www.linkedin.com/in/*"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "profile_filler.js",
        "linkedin_assist.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}