# Supabase Local PostgreSQL
SUPABASE_DB_HOST=localhost
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your_supabase_password_here

# AI Provider Configuration
# Supported providers: gemini, nvidia, alibaba, ollama, openai, custom
AI_PROVIDER=gemini

# --- Antigravity CLI (agy) via the OpenAI-compatible shim (mr-irrelevant/ops/agy_shim.py) ---
# AI_PROVIDER=agy
# AGY_BASE_URL=http://172.26.0.1:8787/v1
# AGY_MODEL=gemini-flash-latest
# AGY_SHIM_TOKEN=        # same value as AGY_SHIM_TOKEN in mr-irrelevant/data/.env

# --- Google Gemini ---
GEMINI_API_KEY=your-gemini-api-key-here
AI_API_KEY=${GEMINI_API_KEY}
AI_MODEL=gemini-2.0-flash

# --- NVIDIA NIM (free tier: https://build.nvidia.com) ---
# AI_PROVIDER=nvidia
# AI_API_KEY=nvapi-your-nvidia-api-key
# AI_MODEL=meta/llama-3.1-70b-instruct
# AI_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Alibaba DashScope (free tier: https://dashscope.console.aliyun.com) ---
# AI_PROVIDER=alibaba
# AI_API_KEY=sk-your-alibaba-api-key
# AI_MODEL=qwen-max
# AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- Ollama (local, free, no API key needed) ---
# AI_PROVIDER=ollama
# AI_MODEL=llama3.1:8b
# AI_BASE_URL=http://localhost:11434/v1

# --- OpenAI ---
# AI_PROVIDER=openai
# AI_API_KEY=sk-your-openai-api-key
# AI_MODEL=gpt-4o-mini

# --- Custom OpenAI-compatible endpoint ---
# AI_PROVIDER=custom
# AI_API_KEY=your-api-key
# AI_MODEL=your-model-name
# AI_BASE_URL=http://your-server:port/v1

# Gotenberg
GOTENBERG_URL=http://localhost:3001

# LinkedIn Copilot — official API (developer app at https://www.linkedin.com/developers/apps
# with the products "Sign In with LinkedIn using OpenID Connect" and "Share on LinkedIn";
# add LINKEDIN_REDIRECT_URI as an authorized redirect URL)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8005/api/linkedin-copilot/oauth/callback
# LINKEDIN_API_VERSION=        # YYYYMM; empty = previous month
LINKEDIN_MAX_POSTS_PER_DAY=2
FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=America/Sao_Paulo

# LinkedIn (apenas para login inicial)
LINKEDIN_EMAIL=your-email@example.com

# Configurações
OUTPUT_DIR=./output
SCRAPE_DELAY=4
MAX_JOBS=20
